{
  "name": "sirnaaz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:node": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build && node scripts/write-headers.mjs",
    "lint": "oxlint",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "db:build-sql": "tsx server/scripts/build-setup-sql.ts",
    "db:check": "tsx --env-file-if-exists=.env server/scripts/check-db.ts",
    "create-admin": "tsx --env-file-if-exists=.env server/scripts/create-admin.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "netlify-cli": "^27.10.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
